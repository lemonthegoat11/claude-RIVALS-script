            Position        =v and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9),
            BackgroundColor3=v and C.ACC or Color3.fromRGB(180,185,200),
        })
    end
    setVis(getter())

    local ob=ibtn(row,UDim2.new(1,0,1,0)); ob.ZIndex=5
    ob.MouseEnter:Connect(function()
        TweenService:Create(row,    TI(0.1),{BackgroundColor3=C.BG3}):Play()
        TweenService:Create(rowStk, TI(0.1),{Transparency=0.08,Color=C.ACC}):Play()
    end)
    ob.MouseLeave:Connect(function()
        TweenService:Create(row,    TI(0.1),{BackgroundColor3=C.BG2}):Play()
        TweenService:Create(rowStk, TI(0.1),{Transparency=0.55,Color=C.TD2}):Play()
    end)
    ob.MouseButton1Click:Connect(function() local nv=not getter(); setter(nv); setVis(nv) end)
end

local function slider(tab,label,mn,mx,getter,setter)
    local row=fr(nil,UDim2.new(1,0,0,60),nil,C.BG2); row.Parent=tab.scr
    corner(row,6); stk(row,C.TD2,1,0.55)
    lbl(row,label,11,C.TW,Enum.TextXAlignment.Left,UDim2.new(0,12,0,8),UDim2.new(0.72,0,0,18),true)
    local vl=lbl(row,tostring(getter()),11,C.ACC,Enum.TextXAlignment.Right,UDim2.new(0.72,0,0,8),UDim2.new(0.28,-12,0,18),true)

    local track=fr(row,UDim2.new(1,-24,0,4),UDim2.new(0,12,0,43),C.BG3); corner(track,2)
    local pct=(getter()-mn)/(mx-mn)
    local fill=fr(track,UDim2.new(pct,0,1,0),nil,C.ACC); corner(fill,2); grad(fill,C.ACC2,C.ACC,0)
    local hdl=fr(track,UDim2.new(0,12,0,12),UDim2.new(pct,-6,0.5,-6),C.ACC); corner(hdl,6)
    stk(hdl,C.ACC,2,0.25)
    -- inner white pip
    local pip=fr(hdl,UDim2.new(0,4,0,4),UDim2.new(0.5,-2,0.5,-2),Color3.fromRGB(215,238,255)); corner(pip,2)

    local sliding=false
    local function upd(pos)
        local r=math.clamp((pos.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local v=math.floor(mn+(mx-mn)*r); setter(v)
        fill.Size=UDim2.new(r,0,1,0); hdl.Position=UDim2.new(r,-6,0.5,-6); vl.Text=tostring(v)
    end
    track.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=true; upd(i.Position) end end)
    track.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=false end end)
    UserInputService.InputChanged:Connect(function(i) if sliding and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i.Position) end end)
end

