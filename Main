-- Universal FPS Cheat | RIVALS & Gun Games
-- Lang: Luau | Target: Roblox (Windows) | Exec: Synapse X / KRNL / Wave / Fluxus
-- Features: ESP · Chams · Aimbot (hold RMB) · Triggerbot

local Players        = game:GetService("Players")
local RunService     = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera         = workspace.CurrentCamera
local LocalPlayer    = Players.LocalPlayer

-- ============================================================
--  CONFIG
-- ============================================================
local Cfg = {
    ESP = {
        Enabled      = false,
        Boxes        = true,
        Names        = true,
        Distance     = true,
        HealthBar    = true,
        Tracers      = false,
        MaxDist      = 1000,
        BoxColor     = Color3.fromRGB(220, 50, 50),
        NameColor    = Color3.fromRGB(230, 230, 230),
        DistColor    = Color3.fromRGB(160, 160, 170),
        TracerColor  = Color3.fromRGB(220, 80, 80),
        TeamCheck    = true,
    },
    Chams = {
        Enabled             = false,
        FillColor           = Color3.fromRGB(200, 40, 40),
        OutlineColor        = Color3.fromRGB(255, 255, 255),
        FillTransparency    = 0.45,
        OutlineTransparency = 0,
        TeamCheck           = true,
    },
    Aimbot = {
        Enabled   = false,
        FOV       = 120,          -- screen-space radius in pixels
        Smoothing = 0.14,         -- 0.0 = instant snap, 1.0 = no movement
        Target    = "Head",       -- "Head" | "HumanoidRootPart"
        ShowFOV   = true,
        HoldKey   = Enum.UserInputType.MouseButton2,
        TeamCheck = true,
    },
    Triggerbot = {
        Enabled   = false,
        Delay     = 0.05,         -- seconds between shots
        TeamCheck = true,
    },
}

-- ============================================================
--  UTILITIES
-- ============================================================
local function getChar(p)   return p.Character end
local function getHum(p)
    local c = getChar(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function getRoot(p)
    local c = getChar(p)
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function isAlive(p)
    local h = getHum(p)
    return h and h.Health > 0
end
local function isEnemy(p)
    if LocalPlayer.Team == nil then return true end
    return p.Team ~= LocalPlayer.Team
end
local function w2s(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on, sp.Z
end
local function dist3(pos)
    local r = getRoot(LocalPlayer)
    return r and (pos - r.Position).Magnitude or math.huge
end

-- ============================================================
--  DRAWING POOL — ESP
-- ============================================================
local ESPPool = {}

local function mkDraw(type, props)
    local o = Drawing.new(type)
    for k,v in pairs(props) do o[k]=v end
    return o
end

local function getESP(player)
    if ESPPool[player] then return ESPPool[player] end
    local e = {
        Box   = mkDraw("Square", { Visible=false, Thickness=1.5, Color=Cfg.ESP.BoxColor,    Filled=false }),
        Name  = mkDraw("Text",   { Visible=false, Size=13,       Color=Cfg.ESP.NameColor,   Outline=true, Center=true, Font=2 }),
        Dist  = mkDraw("Text",   { Visible=false, Size=11,       Color=Cfg.ESP.DistColor,   Outline=true, Center=true, Font=2 }),
        HPBG  = mkDraw("Square", { Visible=false, Thickness=1,   Color=Color3.fromRGB(0,0,0), Filled=true }),
        HPBar = mkDraw("Square", { Visible=false, Thickness=1,   Color=Color3.fromRGB(0,220,80), Filled=true }),
        Trace = mkDraw("Line",   { Visible=false, Thickness=1,   Color=Cfg.ESP.TracerColor }),
    }
    ESPPool[player] = e
    return e
end

local function killESP(player)
    local e = ESPPool[player]
    if not e then return end
    for _,o in pairs(e) do o:Remove() end
    ESPPool[player] = nil
end

-- ============================================================
--  CHAMS — Highlight instances
-- ============================================================
local ChamPool = {}

local function applyHl(player)
    local char = getChar(player)
    if not char or ChamPool[player] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor           = Cfg.Chams.FillColor
    hl.OutlineColor        = Cfg.Chams.OutlineColor
    hl.FillTransparency    = Cfg.Chams.FillTransparency
    hl.OutlineTransparency = Cfg.Chams.OutlineTransparency
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent              = char
    ChamPool[player]       = hl
end

local function killHl(player)
    local hl = ChamPool[player]
    if hl then hl:Destroy() end
    ChamPool[player] = nil
end

-- ============================================================
--  FRAME UPDATES
-- ============================================================
local function updateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local e    = getESP(p)
        local char = getChar(p)
        local hum  = getHum(p)
        local root = getRoot(p)

        if not Cfg.ESP.Enabled or not char or not hum or not root
            or hum.Health <= 0
            or (Cfg.ESP.TeamCheck and not isEnemy(p)) then
            for _,o in pairs(e) do o.Visible = false end
            continue
        end

        local head = char:FindFirstChild("Head")
        if not head then
            for _,o in pairs(e) do o.Visible = false end
            continue
        end

        local topSP, onScreen = w2s(head.Position + Vector3.new(0, head.Size.Y/2 + 0.1, 0))
        local botSP, _,  depth = w2s(root.Position - Vector3.new(0, 3, 0))
        if not onScreen or depth <= 0 then
            for _,o in pairs(e) do o.Visible = false end
            continue
        end

        local d = dist3(root.Position)
        if d > Cfg.ESP.MaxDist then
            for _,o in pairs(e) do o.Visible = false end
            continue
        end

        local h = math.abs(botSP.Y - topSP.Y)
        local w = h * 0.5
        local x, y = topSP.X - w/2, topSP.Y

        -- box
        e.Box.Visible   = Cfg.ESP.Boxes
        e.Box.Position  = Vector2.new(x, y)
        e.Box.Size      = Vector2.new(w, h)
        e.Box.Color     = Cfg.ESP.BoxColor

        -- name
        e.Name.Visible  = Cfg.ESP.Names
        e.Name.Text     = p.Name
        e.Name.Position = Vector2.new(topSP.X, y - 16)

        -- distance
        e.Dist.Visible  = Cfg.ESP.Distance
        e.Dist.Text     = string.format("[%d]", math.floor(d))
        e.Dist.Position = Vector2.new(topSP.X, y + h + 2)

        -- health bar (left strip)
        local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local bx = x - 5
        e.HPBG.Visible   = Cfg.ESP.HealthBar
        e.HPBG.Position  = Vector2.new(bx - 1, y - 1)
        e.HPBG.Size      = Vector2.new(3, h + 2)

        e.HPBar.Visible  = Cfg.ESP.HealthBar
        e.HPBar.Position = Vector2.new(bx, y + h * (1 - pct))
        e.HPBar.Size     = Vector2.new(1.5, h * pct)
        e.HPBar.Color    = Color3.fromRGB(255*(1-pct), 220*pct, 0)

        -- tracer
        local vp = Camera.ViewportSize
        e.Trace.Visible  = Cfg.ESP.Tracers
        e.Trace.From     = Vector2.new(vp.X/2, vp.Y)
        e.Trace.To       = botSP
        e.Trace.Color    = Cfg.ESP.TracerColor
    end

    for p in pairs(ESPPool) do
        if not p.Parent then killESP(p) end
    end
end

local function updateChams()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if Cfg.Chams.Enabled and isAlive(p)
            and (not Cfg.Chams.TeamCheck or isEnemy(p)) then
            applyHl(p)
            local hl = ChamPool[p]
            if hl then
                hl.FillColor           = Cfg.Chams.FillColor
                hl.OutlineColor        = Cfg.Chams.OutlineColor
                hl.FillTransparency    = Cfg.Chams.FillTransparency
                hl.OutlineTransparency = Cfg.Chams.OutlineTransparency
            end
        else
            killHl(p)
        end
    end
    for p in pairs(ChamPool) do
        if not p.Parent then killHl(p) end
    end
end

-- ============================================================
--  AIMBOT
-- ============================================================
local FOVCircle = mkDraw("Circle", {
    Visible=false, Thickness=1,
    Color=Color3.fromRGB(255,255,255),
    Filled=false, NumSides=64,
})

local aimbotHeld = false
UserInputService.InputBegan:Connect(function(i)
    if i.UserInputType == Cfg.Aimbot.HoldKey then aimbotHeld = true end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Cfg.Aimbot.HoldKey then aimbotHeld = false end
end)

local function bestTarget()
    local vp  = Camera.ViewportSize
    local ctr = Vector2.new(vp.X/2, vp.Y/2)
    local bestD, bestPos = Cfg.Aimbot.FOV, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not isAlive(p) then continue end
        if Cfg.Aimbot.TeamCheck and not isEnemy(p) then continue end

        local char = getChar(p)
        if not char then continue end

        local part = char:FindFirstChild(Cfg.Aimbot.Target)
               or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        local sp, on, depth = w2s(part.Position)
        if not on or depth <= 0 then continue end

        local d = (sp - ctr).Magnitude
        if d < bestD then
            bestD   = d
            bestPos = part.Position
        end
    end
    return bestPos
end

local function updateAimbot()
    local vp  = Camera.ViewportSize
    local ctr = Vector2.new(vp.X/2, vp.Y/2)

    FOVCircle.Visible  = Cfg.Aimbot.ShowFOV and Cfg.Aimbot.Enabled
    FOVCircle.Position = ctr
    FOVCircle.Radius   = Cfg.Aimbot.FOV

    if not Cfg.Aimbot.Enabled or not aimbotHeld then return end

    local pos = bestTarget()
    if not pos then return end

    local cur = Camera.CFrame
    local tgt = CFrame.lookAt(cur.Position, pos)
    Camera.CFrame = cur:Lerp(tgt, Cfg.Aimbot.Smoothing)
end

-- ============================================================
--  TRIGGERBOT
-- ============================================================
local tbCooldown = false

local function updateTriggerbot()
    if not Cfg.Triggerbot.Enabled or tbCooldown then return end

    local lc = getChar(LocalPlayer)
    if not lc then return end

    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = { lc }
    rp.FilterType = Enum.RaycastFilterType.Exclude

    local hit = workspace:Raycast(Camera.CFrame.Position, Camera.CFrame.LookVector * 1500, rp)
    if not hit then return end

    local model = hit.Instance:FindFirstAncestorOfClass("Model")
    if not model then return end

    local target = Players:GetPlayerFromCharacter(model)
    if not target or target == LocalPlayer then return end
    if Cfg.Triggerbot.TeamCheck and not isEnemy(target) then return end
    if not isAlive(target) then return end

    tbCooldown = true
    mouse1click()
    task.delay(Cfg.Triggerbot.Delay, function() tbCooldown = false end)
end

-- ============================================================
--  RENDER LOOP
-- ============================================================
RunService.RenderStepped:Connect(function()
    updateESP()
    updateChams()
    updateAimbot()
    updateTriggerbot()
end)

Players.PlayerRemoving:Connect(function(p) killESP(p); killHl(p) end)
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() killHl(p) end)
end)
for _, p in ipairs(Players:GetPlayers()) do
    p.CharacterAdded:Connect(function() killHl(p) end)
end

