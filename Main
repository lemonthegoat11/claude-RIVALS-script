    function() return Cfg.ESP.Boxes     end, function(v) Cfg.ESP.Boxes     = v end)
toggle(tVis, "Names",         "Player names",
    function() return Cfg.ESP.Names     end, function(v) Cfg.ESP.Names     = v end)
toggle(tVis, "Distance",      "Stud distance tag",
    function() return Cfg.ESP.Distance  end, function(v) Cfg.ESP.Distance  = v end)
toggle(tVis, "Health Bars",   "Left-side HP strip",
    function() return Cfg.ESP.HealthBar end, function(v) Cfg.ESP.HealthBar = v end)
toggle(tVis, "Tracers",       "Line from screen bottom",
    function() return Cfg.ESP.Tracers   end, function(v) Cfg.ESP.Tracers   = v end)
slider(tVis, "Max Distance", 100, 2000,
    function() return Cfg.ESP.MaxDist   end, function(v) Cfg.ESP.MaxDist   = v end)

sec(tVis, "Chams")
toggle(tVis, "Chams Master", "AlwaysOnTop highlight",
    function() return Cfg.Chams.Enabled end,
    function(v)
        Cfg.Chams.Enabled = v
        if not v then
            for _, p in ipairs(Players:GetPlayers()) do killHl(p) end
        end
    end)

-- Combat
sec(tComb, "Aimbot")
toggle(tComb, "Aimbot Master",  "Hold RMB to activate",
    function() return Cfg.Aimbot.Enabled  end, function(v) Cfg.Aimbot.Enabled  = v end)
toggle(tComb, "Show FOV Circle","White ring = search radius",
    function() return Cfg.Aimbot.ShowFOV  end,
    function(v) Cfg.Aimbot.ShowFOV = v; if not v then FOVCircle.Visible=false end end)
toggle(tComb, "Team Check",     "Skip teammates",
    function() return Cfg.Aimbot.TeamCheck end, function(v) Cfg.Aimbot.TeamCheck = v end)
slider(tComb, "FOV Radius (px)", 20, 500,
    function() return Cfg.Aimbot.FOV       end, function(v) Cfg.Aimbot.FOV       = v end)
slider(tComb, "Smoothing ×100",  1, 100,
    function() return math.floor(Cfg.Aimbot.Smoothing*100) end,
    function(v) Cfg.Aimbot.Smoothing = v/100 end)

sec(tComb, "Triggerbot")
toggle(tComb, "Triggerbot",        "Auto-fire on crosshair hit",
    function() return Cfg.Triggerbot.Enabled   end, function(v) Cfg.Triggerbot.Enabled   = v end)
toggle(tComb, "Team Check (Trig)", "Skip teammates",
    function() return Cfg.Triggerbot.TeamCheck end, function(v) Cfg.Triggerbot.TeamCheck = v end)
slider(tComb, "Fire Delay (ms)",  0, 300,
    function() return math.floor(Cfg.Triggerbot.Delay*1000) end,
    function(v) Cfg.Triggerbot.Delay = v/1000 end)

-- Misc
sec(tMisc, "Global")
toggle(tMisc, "Global Team Check", "Sync all team checks at once",
    function() return Cfg.ESP.TeamCheck end,
    function(v)
        Cfg.ESP.TeamCheck        = v
        Cfg.Chams.TeamCheck      = v
        Cfg.Aimbot.TeamCheck     = v
        Cfg.Triggerbot.TeamCheck = v
    end)

